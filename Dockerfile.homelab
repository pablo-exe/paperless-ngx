# Build the folder-enabled UI on the current official runtime image.
FROM node:24-trixie-slim@sha256:43b9ba1142b8dcf33fa8f922ca1be85714adc444e0586c7cf7726daaeabc1bea AS frontend
WORKDIR /src/src-ui
COPY src-ui/ ./
RUN corepack enable && pnpm install --frozen-lockfile
ENV NG_BUILD_MAX_WORKERS=2 NODE_OPTIONS=--max-old-space-size=2048
RUN pnpm run build --configuration production --localize

FROM ghcr.io/paperless-ngx/paperless-ngx:3.5.0@sha256:8c1e2c4e0abb50576c7a09f062ed581e2d955e298a302e1e196a35338639005e
USER root
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && uv pip install --system --no-cache --no-deps certifi==2026.10.19
WORKDIR /usr/src/paperless/src
COPY --chown=1000:1000 src/ ./
RUN rm -rf documents/static/frontend
COPY --from=frontend --chown=1000:1000 /src/src/documents/static/frontend/ ./documents/static/frontend/
RUN sed -i '1s|^#!/usr/bin/env python3|#!/command/with-contenv python3|' manage.py \
    && PAPERLESS_SECRET_KEY=build-time-dummy s6-setuidgid paperless python3 manage.py collectstatic --clear --no-input --link \
    && PAPERLESS_SECRET_KEY=build-time-dummy s6-setuidgid paperless python3 manage.py compilemessages \
    && /usr/local/bin/deduplicate.py /usr/src/paperless/static/
